{
  "compilerOptions": {
    "target": "ES2024",
    // DOM: the scripts import src/actions.ts, whose types reach the events
    // module (JSX, document).
    "lib": ["ES2024", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"]
  },
  "include": [
    "paski.ts",
    "random.ts",
    "compress.ts",
    "map.ts",
    "vite.config.ts"
  ]
}
